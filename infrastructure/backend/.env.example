# Telegram API credentials
# Get these from https://my.telegram.org/apps
API_ID=
API_HASH=

# Phone number associated with your Telegram account (с кодом страны, например +971501234567)
PHONE_NUMBER=

# Batch processing configuration
BATCH_SIZE=100  # Количество сообщений для обработки за один раз
MAX_MESSAGES=1000  # Максимальное количество сообщений за один запуск

# Scheduler configuration (in seconds)
SCHEDULER_INTERVAL_SECONDS=60  # Запуск каждые 60 секунд

# MongoDB configuration
MONGO_URL=mongodb://root:example@mongodb:27017
MONGO_DB_NAME=db

MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=example

ME_CONFIG_MONGODB_ADMINUSERNAME=root
ME_CONFIG_MONGODB_ADMINPASSWORD=example
ME_CONFIG_MONGODB_URL=mongodb://root:example@mongodb:27017/
ME_CONFIG_BASICAUTH=false

# Logging configuration
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

OPENAI_API_KEY=

TELEGRAM_BOT_TOKEN=

SESSION_STRING=your_session_string_here